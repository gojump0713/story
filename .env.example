# Supabase를 쓸 경우 .env 파일을 만들어 아래 값을 채우세요. (.env는 커밋 금지)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
# 삽화 모델(선택). 비우면 gpt-image-1 → 실패 시 dall-e-3 자동 폴백.
# 계정에 따라 dall-e-3만 가능하면 dall-e-3 으로 지정.
VITE_OPENAI_IMAGE_MODEL=

# 챗봇(Upstage Solar) 키는 클라이언트(.env/VITE_)에 두지 마세요 — 정적 사이트라 노출됩니다.
# 대신 Supabase Edge Function의 secret으로만 보관합니다:
#   supabase secrets set UPSTAGE_API_KEY=up_xxx
#   supabase secrets set UPSTAGE_MODEL=solar-pro2   (선택, 기본 solar-pro2)
